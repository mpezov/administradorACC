# Viewer Manager v0.4
# Preferir la misma integración S2S que ya tiene acceso al ACC de ANIN.
APS_CLIENT_ID_S2S=
APS_CLIENT_SECRET_S2S=

# Alias admitidos si ya existen en tu .env:
# APS_CLIENT_ID=
# APS_CLIENT_SECRET=
# ACC_CLIENT_ID=
# ACC_CLIENT_SECRET=

# Token PKCE opcional para consultas Data Management del backend.
# NUNCA se entrega este token amplio al navegador.
# APS_TOKEN_FILE=D:\miguel\anin\inventarioACC\acc_tokens.json

BIM_VIEW_EXTENSIONS=nwd,nwc,rvt,ifc
FEDERATED_CANDIDATE_MIN_SCORE=70
FEDERATED_CANDIDATE_LIMIT=8
